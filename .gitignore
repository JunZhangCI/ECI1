# Ignore every new file by default. Add explicit allow rules below for
# source files and small shared project metadata that are safe to track.
*

# Root project metadata
!/.gitignore
!/.gitattributes
!/.pre-commit-config.yaml
!/README.md
!/requirements.txt
!/ECI1.prj

# Shared editor settings
!/.vscode/
!/.vscode/*.json

# Shared pipeline configuration
!/config/
!/config/**/
!/config/*.json
!/config/**/*.json

# MATLAB, Python, and small text source files
!/3_code/
!/3_code/**/
!/3_code/.gitignore
!/3_code/**/.gitignore
!/3_code/**/*.m
!/3_code/**/*.py
!/3_code/**/*.yaml
!/3_code/**/*.yml
!/3_code/**/*.csv
!/3_code/**/*.sh
!/3_code/**/*.txt

# Notebooks are intentionally not whitelisted here. Existing tracked
# notebooks stay tracked, but new notebooks require exact path approval.
